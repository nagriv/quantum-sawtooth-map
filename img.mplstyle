# thesis.mplstyle

font.family: serif
mathtext.fontset: cm

axes.labelsize: 14
font.size: 18
legend.fontsize: 16
xtick.labelsize: 12
ytick.labelsize: 12
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
axes.grid: True
grid.alpha: 0.10
grid.linestyle: --

# --- Ticks ---
xtick.direction: in
ytick.direction: in
xtick.major.size: 5
ytick.major.size: 5
xtick.major.width: 1.
ytick.major.width: 1.
xtick.minor.size: 3
ytick.minor.size: 3
xtick.minor.width: 0.8
ytick.minor.width: 0.8
xtick.top: True
ytick.right: True
xtick.minor.visible: True
ytick.minor.visible: True

# ---Format math visualization---
axes.formatter.use_mathtext: True
axes.formatter.limits: -2, 3